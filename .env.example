# Anthropic - required for `learn`, `plan`, `scout`, `narrate`
ANTHROPIC_API_KEY=

# ElevenLabs - required unless you pass --no-voice or VDG_TTS_PROVIDER=say
ELEVENLABS_API_KEY=
# Matilda by default. Other verified ids: George JBFqnCBsd6RMkjVDRZzb,
# Brian nPczCjzI2devNBz1zQrb, Daniel onwK4e9ZLuTAKqWW03F9, Rachel 21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX
# Delivery rate; above ~1.15 diction suffers on UI labels and names
VDG_TTS_SPEED=1.08

# Optional: alternative TTS provider (elevenlabs | openai | say)
VDG_TTS_PROVIDER=elevenlabs
OPENAI_API_KEY=

# Demo environment credentials, referenced by `vdg connect`
VDG_DEMO_USERNAME=
VDG_DEMO_PASSWORD=

# Opening cover art and the colour painted behind it from frame one
VDG_BRAND_COVER=assets/factorial-cover.png
VDG_BRAND_COLOR=#ff345f

# Opening pacing: beat before the title rises, and how long the rise takes
VDG_TITLE_DELAY_MS=880
VDG_TITLE_RISE_MS=1320
# Minimum length of the opening cover
VDG_TITLE_MS=4200

# Background music. Drop a file at assets/music.mp3 and it is used automatically.
# VDG_MUSIC=assets/music.mp3
# VDG_MUSIC_LUFS=-26      # bed loudness before ducking (-30 quieter, -22 louder)
# VDG_MUSIC_DUCK=12       # how hard the voice pushes the music down
# VDG_MUSIC_FADE=1.5      # seconds of fade at each end

# HTTP service (vdg serve)
# VDG_API_TOKEN=            # bearer token; unset leaves the API open
# VDG_CORS_ORIGINS=*       # comma-separated origins allowed from a browser
# VDG_SERVER_PRODUCT=factorial
# VDG_SERVER_PROFILE=demo
# VDG_PORT=8080
